# ============================================================
# WatchWicket ScoreBox - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values
#
# Get your Supabase credentials from:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ============================================================

# Your Supabase Project URL
# Example: https://jwkobz.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Your Supabase Anon/Public Key
# Find in: Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: hCaptcha Site Key (if using captcha)
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
